{
  "id": "paper-root",
  "type": "column",
  "theme": {
    "light": "paper-herdr",
    "dark": "paper-herdr-dark"
  },
  "preview": "layouts/paper-herdr.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "ui_font": "Host Grotesk",
  "font": "Geist Mono",
  "font_size": 13,
  "terminal_padding": [
    10,
    14
  ],
  "children": [
    {
      "id": "tabs",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "paper-shell",
        "props": {
          "role": "tabs"
        }
      }
    },
    {
      "id": "paper-body",
      "type": "row",
      "padding": [
        10,
        10
      ],
      "gap": 10,
      "children": [
        {
          "id": "paper-rail",
          "type": "block",
          "size": {
            "px": 48
          },
          "resizable": false,
          "background": "surface",
          "radius": 20,
          "shadow": "sm",
          "content": {
            "mod": "paper-shell",
            "props": {
              "role": "rail"
            }
          }
        },
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 184
          },
          "min": 160,
          "max": 260,
          "background": "surface",
          "radius": 20,
          "shadow": "sm",
          "content": {
            "mod": "paper-shell",
            "props": {
              "role": "nav"
            }
          }
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 20,
                  "background": "background",
                  "lone": true,
                  "focus": {
                    "width": 1,
                    "color": "input"
                  },
                  "header": {
                    "content": {
                      "mod": "paper-shell",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 32,
                    "position": "top",
                    "reveal": "always"
                  },
                  "shadow": "sm"
                }
              }
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 300
          },
          "min": 240,
          "max": 420,
          "background": "surface",
          "radius": 20,
          "shadow": "sm",
          "padding": [
            6,
            0
          ],
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "paper-files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "widgets",
          "type": "column",
          "size": {
            "px": 212
          },
          "min": 196,
          "max": 280,
          "gap": 10,
          "children": [
            {
              "id": "w-agents",
              "type": "block",
              "background": "surface",
              "radius": 20,
              "shadow": "sm",
              "content": {
                "mod": "paper-widgets",
                "props": {
                  "kind": "agents"
                }
              }
            },
            {
              "id": "w-context",
              "type": "block",
              "size": {
                "px": 164
              },
              "resizable": false,
              "background": "surface",
              "radius": 20,
              "shadow": "sm",
              "content": {
                "mod": "paper-widgets",
                "props": {
                  "kind": "context"
                }
              }
            },
            {
              "id": "w-usage",
              "type": "block",
              "size": {
                "px": 140
              },
              "resizable": false,
              "background": "surface",
              "radius": 20,
              "shadow": "sm",
              "content": {
                "mod": "paper-widgets",
                "props": {
                  "kind": "usage"
                }
              }
            },
            {
              "id": "w-git",
              "type": "block",
              "size": {
                "px": 108
              },
              "resizable": false,
              "background": "surface",
              "radius": 20,
              "shadow": "sm",
              "content": {
                "mod": "paper-widgets",
                "props": {
                  "kind": "git"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
