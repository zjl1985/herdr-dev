{
  "id": "gmunk-root",
  "type": "column",
  "theme": "gmunk-herdr",
  "preview": "layouts/gmunk-herdr.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ],
  "background": "canvas",
  "ui_font": "Monaspace Krypton",
  "terminal_padding": [
    12,
    14
  ],
  "children": [
    {
      "id": "command-body",
      "type": "row",
      "padding": [
        0,
        12
      ],
      "gap": 12,
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 152
          },
          "content": {
            "mod": "gmunk-shell",
            "props": {
              "role": "nav"
            }
          },
          "min": 130,
          "max": 210,
          "hidden": true
        },
        {
          "id": "drawer-gutter",
          "type": "column",
          "size": {
            "px": 40
          },
          "resizable": false,
          "children": []
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 32
              },
              "content": {
                "mod": "gmunk-shell",
                "props": {
                  "role": "tabs"
                }
              },
              "window_drag": true
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "input"
                  },
                  "header": {
                    "content": {
                      "mod": "gmunk-shell",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 27,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "diagnostic-rail",
              "type": "block",
              "size": {
                "px": 55
              },
              "content": {
                "mod": "gmunk-shell",
                "props": {
                  "role": "diagnostics"
                }
              }
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 320
          },
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "gmunk-instruments",
          "type": "block",
          "size": {
            "px": 324
          },
          "content": {
            "mod": "gmunk-telemetry"
          },
          "min": 292,
          "max": 390
        }
      ],
      "floating": [
        {
          "id": "gmunk-navigation-drawer",
          "content": {
            "mod": "gmunk-shell",
            "props": {
              "role": "drawer"
            }
          },
          "edge": "left",
          "align": "center",
          "peek": 36
        }
      ]
    },
    {
      "id": "system-strip",
      "type": "block",
      "size": {
        "px": 28
      },
      "content": {
        "mod": "gmunk-shell",
        "props": {
          "role": "footer"
        }
      }
    }
  ]
}
