{
  "id": "gmunk-root",
  "type": "column",
  "theme": "gmunk-herdr",
  "preview": "layouts/gmunk-herdr.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ],
  "background": "canvas",
  "ui_font": "Rajdhani",
  "terminal_padding": [
    6,
    8
  ],
  "children": [
    {
      "id": "command-body",
      "type": "row",
      "padding": [
        4,
        4
      ],
      "gap": 6,
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 160
          },
          "min": 148,
          "max": 200,
          "content": {
            "mod": "gmunk-shell",
            "props": {
              "role": "nav"
            }
          }
        },
        {
          "id": "drawer-gutter",
          "type": "column",
          "size": {
            "px": 16
          },
          "resizable": false,
          "hidden": true,
          "children": []
        },
        {
          "id": "stage",
          "type": "row",
          "gap": 0,
          "children": [
            {
              "id": "bezel-left",
              "type": "block",
              "size": {
                "px": 8
              },
              "resizable": false,
              "content": {
                "mod": "gmunk-shell",
                "props": {
                  "role": "bezel",
                  "side": "left"
                }
              }
            },
            {
              "id": "work",
              "type": "column",
              "gap": 0,
              "children": [
                {
                  "id": "tabs",
                  "type": "block",
                  "size": {
                    "px": 30
                  },
                  "content": {
                    "mod": "gmunk-shell",
                    "props": {
                      "role": "tabs"
                    }
                  },
                  "window_drag": true
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 4,
                      "radius": 0,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "gmunk-shell",
                          "props": {
                            "role": "pane"
                          }
                        },
                        "height": 24,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                }
              ]
            },
            {
              "id": "bezel-right",
              "type": "block",
              "size": {
                "px": 8
              },
              "resizable": false,
              "content": {
                "mod": "gmunk-shell",
                "props": {
                  "role": "bezel",
                  "side": "right"
                }
              }
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 320
          },
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "gmunk-instruments",
          "type": "block",
          "size": {
            "px": 240
          },
          "min": 220,
          "max": 320,
          "content": {
            "mod": "gmunk-telemetry"
          }
        }
      ],
      "floating": [
        {
          "id": "gmunk-navigation-drawer",
          "content": {
            "mod": "gmunk-shell",
            "props": {
              "role": "drawer"
            }
          },
          "edge": "left",
          "align": "start",
          "peek": 40
        }
      ]
    },
    {
      "id": "system-strip",
      "type": "block",
      "size": {
        "px": 26
      },
      "content": {
        "mod": "gmunk-shell",
        "props": {
          "role": "footer"
        }
      }
    }
  ]
}
